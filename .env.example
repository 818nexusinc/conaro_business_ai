# CONARO Business AI configuration. Copy to .env for local runs; on a host, use its secret store.
# Never commit real values.

# development | staging | production
BAI_ENV=development

# PostgreSQL (e.g. a Supabase project). Empty = embedded PostgreSQL (PGlite), in BAI_PGLITE_DIR if set.
DATABASE_URL=
BAI_PGLITE_DIR=.pglite

# Control centre. PORT is set by hosts such as Railway; BAI_PORT is used locally.
BAI_PORT=8790
BAI_PUBLIC_URL=http://localhost:8790
# Seconds between agents' cycles.
BAI_TICK_SECONDS=300

# Required: signs customers' one-click unsubscribe links. 32+ random characters.
BAI_UNSUBSCRIBE_SECRET=

# Optional: Claude for customer replies and the Business Manager chat. Without it, replies come from
# approved facts only and the chat shows the records. Set a spend limit on the key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Optional: links with the other CONARO applications (docs/INTEROP.md). Two DIFFERENT keys, 32+ characters each.
MARKETPLACE_BASE_URL=https://www.conaro.ca
BAI_MARKETPLACE_LINK_SECRET=
BAI_BOS_LINK_SECRET=
